{
    "name": "log-cpp",
    "version": "1.0.0",
    "port-version": 5,
    "homepage": "https://github.com/feng9201/log-cpp",
    "description": "Thin spdlog facade with per-sink levels, optional Qt header formatter and sqlite",
    "license": null,
    "dependencies": [
        {
            "name": "vcpkg-cmake",
            "host": true
        },
        {
            "name": "vcpkg-cmake-config",
            "host": true
        },
        "spdlog"
    ],
    "default-features": [],
    "features": {
        "shared": {
            "description": "Build as shared library. Without this feature, linkage follows the triplet."
        },
        "sqlite": {
            "description": "Enable sqlite sink",
            "dependencies": [
                "sqlitecpp"
            ]
        }
    }
}
